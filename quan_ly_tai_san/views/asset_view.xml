<odoo>
    <record id="view_custom_asset_tree" model="ir.ui.view">
        <field name="name">custom.asset.tree</field>
        <field name="model">custom.asset</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>
    <record id="view_custom_asset_form" model="ir.ui.view">
        <field name="name">custom.asset.form</field>
        <field name="model">custom.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="category_id"/> </group>
                    </group>
                    <notebook>
                        <page string="Lịch sử bàn giao">
                            <field name="assignment_ids" readonly="1"/>
                        </page>
                        <page string="Nhật ký bảo trì">
                            <field name="maintenance_ids">
                                <tree editable="bottom">
                                    <field name="maintenance_date"/>
                                    <field name="reason"/>
                                    <field name="cost"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_asset_assignment" model="ir.actions.act_window">
    <field name="name">Bàn giao tài sản</field>
    <field name="res_model">asset.assignment</field>
    <field name="view_mode">tree,form</field>
    </record>
    <record id="action_custom_asset" model="ir.actions.act_window">
        <field name="name">Quản lý Tài sản</field>
        <field name="res_model">custom.asset</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_asset_root" name="Quản lý Tài sản" sequence="10"/>
    <menuitem id="menu_asset_list" name="Danh mục tài sản" parent="menu_asset_root" action="action_custom_asset"/>
</odoo>